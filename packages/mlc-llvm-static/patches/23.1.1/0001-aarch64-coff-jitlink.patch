diff --git a/llvm/test/ExecutionEngine/JITLink/AArch64/COFF_relocations.s b/llvm/test/ExecutionEngine/JITLink/AArch64/COFF_relocations.s
new file mode 100644
index 0000000..5528eca
--- /dev/null
+++ b/llvm/test/ExecutionEngine/JITLink/AArch64/COFF_relocations.s
@@ -0,0 +1,95 @@
+# RUN: rm -rf %t && mkdir -p %t
+# RUN: llvm-mc -triple=aarch64-pc-windows-msvc -filetype=obj -o %t/coff_reloc.o %s
+# RUN: llvm-jitlink -noexec -slab-allocate 100Kb -slab-address 0x10000000 \
+# RUN:   -slab-page-size 4096 -abs __ImageBase=0x10000000 \
+# RUN:   -abs external_func=0x7000000000 -abs external_data=0x12345008 \
+# RUN:   -check %s %t/coff_reloc.o
+
+        .text
+        .globl main, page, page_negative, pageoff, load8, load128, address
+        .globl call_external, jump_external, import_page, import_load
+        .p2align 2
+main:
+        ret
+page:
+        adrp x0, data+4096
+# jitlink-check: decode_operand(page, 1) = ((data+4096)[63:12] - page[63:12])[20:0]
+page_negative:
+        adrp x0, data-16
+# jitlink-check: decode_operand(page_negative, 1)[20:0] = ((data-16)[63:12] - page_negative[63:12])[20:0]
+pageoff:
+        add x0, x0, :lo12:data+8
+# jitlink-check: decode_operand(pageoff, 2) = (data+8)[11:0]
+load8:
+        ldr x0, [x0, :lo12:data+8]
